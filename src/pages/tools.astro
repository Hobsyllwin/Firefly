---
import IpLookupTool from "@components/pages/IpLookupTool.svelte";
import QrCodeTool from "@components/pages/QrCodeTool.svelte";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.tools) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.tools);
const description = i18n(I18nKey.toolsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-4"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon is:inline name="material-symbols:build-rounded" class="text-[1.5rem]"></Icon>
        </div>
        <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          {title}
        </div>
      </div>
      {description && (
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {description}
        </p>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <QrCodeTool client:load />
    <IpLookupTool client:load />
    <a
      href="https://sd.weiduo.tech/"
      target="_blank"
      rel="noopener noreferrer"
      class="tool-link-card card-base rounded-(--radius-large) h-fit overflow-hidden flex items-center gap-3 px-6 py-6 md:px-9 md:py-6"
    >
      <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
        <Icon is:inline name="material-symbols:auto-awesome-rounded" class="text-[1.5rem]"></Icon>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-2xl font-bold text-90">Stable Diffusion</div>
        <p class="text-sm text-50 mt-1">AI 绘图工作台，点击直达</p>
      </div>
      <Icon is:inline name="material-symbols:open-in-new-rounded" class="text-50 shrink-0 opacity-60 text-[1rem]"></Icon>
    </a>
    <a
      href="https://comfy.weiduo.tech/"
      target="_blank"
      rel="noopener noreferrer"
      class="tool-link-card card-base rounded-(--radius-large) h-fit overflow-hidden flex items-center gap-3 px-6 py-6 md:px-9 md:py-6"
    >
      <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
        <Icon is:inline name="material-symbols:account-tree-rounded" class="text-[1.5rem]"></Icon>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-2xl font-bold text-90">ComfyUI</div>
        <p class="text-sm text-50 mt-1">节点式 AI 绘图工作流，点击直达</p>
      </div>
      <Icon is:inline name="material-symbols:open-in-new-rounded" class="text-50 shrink-0 opacity-60 text-[1rem]"></Icon>
    </a>
  </div>
</MainGridLayout>

<style>
  .tool-link-card {
    position: relative;
    transition:
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .tool-link-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      color-mix(in srgb, var(--primary) 22%, transparent) 50%,
      transparent 65%
    );
    transform: translateX(-140%);
    pointer-events: none;
  }

  .tool-link-card:hover {
    background: color-mix(in srgb, var(--primary) 8%, transparent);
    box-shadow: inset 0 0 20px color-mix(in srgb, var(--primary) 20%, transparent);
  }

  .tool-link-card:hover::before {
    transform: translateX(140%);
    transition: transform 0.6s ease;
  }
</style>
